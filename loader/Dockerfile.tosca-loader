# xosproject/tosca-loader

FROM alpine:3.7

RUN apk add --no-cache httpie=0.9.9-r0 && \
    rm -r /root/.cache

COPY tosca-loader.sh /usr/local/bin/tosca-loader.sh

CMD [ "/usr/local/bin/tosca_loader.sh" ]
